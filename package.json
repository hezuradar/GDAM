{
  "name": "compras-proveedores",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "expo": "~57.0.27",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.25",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261010.1",
    "@react-native/jest-preset": "^0.86.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "typescript": "~6.0.3",
    "wrangler": "^4.149.0"
  },
  "scripts": {
    "start": "expo start --web",
    "build": "expo export --platform web",
    "dev": "npm run build && wrangler d1 migrations apply compras-db --local && wrangler dev",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit && tsc -p src/worker/tsconfig.json",
    "db:migrate": "wrangler d1 migrations apply compras-db --remote",
    "deploy": "npm run build && wrangler d1 migrations apply compras-db --remote && wrangler deploy"
  },
  "jest": {
    "projects": [
      {
        "displayName": "app",
        "preset": "jest-expo",
        "testMatch": ["<rootDir>/src/domain/**/__tests__/**/*.test.ts"],
        "collectCoverageFrom": ["<rootDir>/src/domain/**/*.ts", "!<rootDir>/src/domain/types.ts"]
      },
      {
        "displayName": "worker",
        "preset": "jest-expo",
        "testEnvironment": "node",
        "testMatch": ["<rootDir>/src/worker/**/__tests__/**/*.test.ts"],
        "collectCoverageFrom": ["<rootDir>/src/worker/session.ts", "<rootDir>/src/worker/validate.ts"]
      }
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "private": true
}
