{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "compras-gdam",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true
  },
  // Static web app (dist/) + JSON API under /api/* handled by the Worker.
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    // Client-side routes (/proveedores, /pedido/3…) are served by index.html.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "compras-db",
      "database_id": "3f20d9bb-54ae-43cd-9e7e-48ca21f2b506",
      "migrations_dir": "migrations"
    }
  ],
  // Hourly EUR/USD market rate refresh.
  "triggers": {
    "crons": ["7 * * * *"]
  },
  // Sign-in password: Worker secret APP_PASSWORD (min. 10 characters), never in this repository:
  //   npx wrangler secret put APP_PASSWORD
  // Without it the API stays closed.
}
